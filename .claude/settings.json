{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(python ./.trellis/scripts/task.py --help)",
      "Bash(python ./.trellis/scripts/task.py set-meta --help)",
      "Read(//c/Users/14683/.claude/**)",
      "Bash(ls \"C:/Users/14683/.claude/skills\" \"C:/Users/14683/.claude/commands\" \"C:/Users/14683/.claude/plugins\" 2>/dev/null; echo \"=== vidsage .agents ===\"; ls -R f:/personal_project/vidSage/.agents 2>/dev/null | head -40)",
      "Bash(git ls-remote *)",
      "Read(//f/learning_projects/asr_references/**)",
      "Bash(cd \"F:/learning_projects/asr_references/AI-Media2Doc\" && find frontend -type f -not -path '*/.git/*' -not -path '*/node_modules/*' -not -path '*/dist/*' | sort)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session-start.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session-start.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session-start.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/inject-subagent-context.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/inject-subagent-context.py",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/inject-workflow-state.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python .claude/hooks/statusline.py"
  },
  "enabledPlugins": {}
}
