{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(python ./.trellis/scripts/task.py --help)",
      "Bash(python ./.trellis/scripts/task.py set-meta --help)",
      "Read(//c/Users/14683/.claude/**)",
      "Bash(ls \"C:/Users/14683/.claude/skills\" \"C:/Users/14683/.claude/commands\" \"C:/Users/14683/.claude/plugins\" 2>/dev/null; echo \"=== vidsage .agents ===\"; ls -R f:/personal_project/vidSage/.agents 2>/dev/null | head -40)",
      "Bash(git ls-remote *)",
      "Read(//f/learning_projects/asr_references/**)",
      "Bash(cd \"F:/learning_projects/asr_references/AI-Media2Doc\" && find frontend -type f -not -path '*/.git/*' -not -path '*/node_modules/*' -not -path '*/dist/*' | sort)",
      "Bash(python -m pip list)",
      "Bash(echo \"\\(exit $?\\)\")",
      "Read(//f/python_soft/python_3.13.7/**)",
      "Read(//f/python_soft/python_3.13.7/Scripts//**)",
      "Bash(ls /f/learning_projects/asr_references/ 2>&1)",
      "Read(//f/learning_projects/asr_references//**)",
      "Read(//f/app_soft/ffmpeg/bin//**)",
      "Bash(awk '{print $5, $9}')",
      "Bash(awk '{print $5,$9}')",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:mintlify.wiki)",
      "Read(//f/learning_projects/asr_references/VideoCaptioner/videocaptioner/cli/commands/**)",
      "Bash(./tools/yt-dlp.exe --help)",
      "Bash(./tools/yt-dlp.exe -U)",
      "Bash(echo \"=== exit: $? ===\")",
      "Bash(./tools/yt-dlp.exe --version)",
      "Read(//f/app_soft/ffmpeg/bin/**)",
      "Bash(awk '{printf \"%12d bytes  %s\\\\n\", $5, $9}')",
      "Bash(git check-ignore *)",
      "Bash(./tools/yt-dlp.exe --simulate -v asr-service/sample.m4a)",
      "Bash(./tools/yt-dlp.exe --simulate asr-service/sample.m4a)",
      "Bash(echo \"exit=$?\")",
      "Bash(./tools/yt-dlp.exe -v --simulate asr-service/sample.m4a)",
      "Bash(PYTHONIOENCODING=utf-8 ./tools/yt-dlp.exe -v --simulate asr-service/sample.m4a)",
      "Bash(./tools/yt-dlp.exe --simulate \"中文abc\")",
      "Bash(PYTHONIOENCODING=utf-8 ./tools/yt-dlp.exe --simulate \"中文abc\")"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session-start.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session-start.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session-start.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/inject-subagent-context.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/inject-subagent-context.py",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/inject-workflow-state.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python .claude/hooks/statusline.py"
  },
  "enabledPlugins": {}
}
