target/
*.class
*.log
.idea/
*.iml
.vscode/
.DS_Store
node_modules/
dist/
.env
!frontend/.env
model-cache/
asr-service/
# 忽略 tools/ 下内容但保留例外（git 语义：父目录本身不能被排除，否则否定例外失效）
/tools/*
!tools/trellis-worktree.sh
/backend/data/

# 设计原型沙盒（独立于正式前端，不进仓库）
/prototype/

# 会话本地产物（Playwright MCP 快照日志 / 冒烟测试临时文件 / 会话计划草稿）
.playwright-mcp/
.zcode/tmp/
.zcode/plans/

# 本地密钥配置：application-local.yml 里是真 Key。别只靠 .git/info/exclude——
# 那个文件不随仓库走，换台机器克隆后 `git add -A` 就把 Key 提上去了
application-local.yml

# Eclipse 产物（Maven 项目用 IDEA 时也不该进仓库）
.classpath
.project
.factorypath
.settings/
