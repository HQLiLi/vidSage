<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.vidsage</groupId>
    <artifactId>vidsage-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>vidsage-backend</name>
    <description>VidSage video knowledge assistant backend</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Boot 4（Framework 7）必须用 springdoc 3.x，2.x 启动报错；knife4j 尚未适配 Boot 4 故不引入 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>
        <!--        OpenAI 兼容 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- DeepSeek 官方 starter：翻译走 LLM 唯一路线（DeepSeek，OpenAI 兼容） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>dashscope-sdk-java</artifactId>
            <version>2.20.6</version>
            <exclusions>
                <!-- SDK 自带 slf4j-simple，与 Spring Boot 的 Logback 冲突 -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
                <!--
                  SDK 的 function-call 支持拖进 jsonschema-generator:4.31.1（按 Jackson 2 编译）。
                  它与 Spring AI 需要的 5.0.0（按 Jackson 3 编译）是同一个坐标，Maven 取「最近者胜」
                  选了 4.31.1，于是 Spring AI 的 BeanOutputConverter 运行时炸 NoSuchMethodError
                  （getObjectMapper() 的返回类型从 com.fasterxml.* 变成了 tools.jackson.*，
                  描述符对不上）。影响面不止 .entity()：tool calling 生成参数 schema 也走它。
                  已核实 SDK 全部版本（含最新 2.23.1）都钉着 4.31.1，升级解决不了。
                  SDK 自己在该依赖上方标注「function call support」，而本项目只用它的 ASR
                  （audio.asr.transcription.Transcription），用不到——故排除，让 5.0.0 进来。
                  若将来要用 SDK 的 function calling：删掉这条排除，同时 .entity() 会失效。
                  同坐标只能留一个大版本，两者不可兼得。（2026-09-27 实测）
                -->
                <exclusion>
                    <groupId>com.github.victools</groupId>
                    <artifactId>jsonschema-generator</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @WebMvcTest 在 Boot 4 拆分为独立的 webmvc-test 模块，控制器切片测试必需 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

